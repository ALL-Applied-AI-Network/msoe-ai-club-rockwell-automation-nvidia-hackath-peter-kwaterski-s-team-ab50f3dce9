NOT_MEASURED = "Not measured"
COUNT_FIELDS = ("detected", "eligible", "attempted", "sorted", "skipped", "failed")


@dataclass
class Alert:
    id: str
    object_id: str
    category: str
    outcome: str
    reason: str


@dataclass
class ViewStatus:
    """Internal presentation shape; adapt real telemetry into this shape later."""

    run_id: str
    status: str
    stage: str
    source: str
    simulated: bool
    generated_at: Optional[datetime] = None
    counts: dict = field(default_factory=dict)
    metrics: dict = field(default_factory=dict)
    alerts: list = field(default_factory=list)



class StatusSource(Protocol):
    """Replaceable, read-only adapter. Called only on the worker thread.

    Future network implementations must bound their I/O timeouts and implement
    certificate verification/mTLS in the adapter, without touching widget code.
    """

    def read_status(self) -> ViewStatus: ...



